rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes unless explicitly matched below.
    // All product, purchasing, payment, inventory, order, fulfillment, distribution,
    // marketing waitlist, and sales-lead collections are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null
        && request.auth.uid is string
        && (!('firebase' in request.auth.token) || request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin access strictly restricted to the verified administrator account
    function isAdmin() {
      return isVerifiedUser()
        && request.auth.token.email == 'embenohp@gmail.com';
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (stateless helpers; no existing()/diff() calls)
    // -------------------------------------------------------------------------
    function isValidCustomerProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'preferredCountry',
          'emailVerified',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'phone',
          'preferredCountry',
          'emailVerified',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && !data.displayName.matches('^\\s*$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && data.preferredCountry is string
        && data.preferredCountry.size() >= 2
        && data.preferredCountry.size() <= 80
        && !data.preferredCountry.matches('^\\s*$')
        && data.emailVerified is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPreferences(data, userId) {
      return data.keys().hasAll([
          'userId',
          'preferredCountry',
          'emailNotifications',
          'whatsappUpdates',
          'cookieConsent',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'preferredCountry',
          'emailNotifications',
          'whatsappUpdates',
          'cookieConsent',
          'updatedAt'
        ])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.preferredCountry is string
        && data.preferredCountry.size() >= 2
        && data.preferredCountry.size() <= 80
        && !data.preferredCountry.matches('^\\s*$')
        && data.emailNotifications is bool
        && data.whatsappUpdates is bool
        && data.cookieConsent in ['accepted', 'dismissed', 'unset']
        && data.updatedAt is timestamp;
    }

    function isValidWebsiteSettings(data) {
      return data.keys().hasAll([
          'brandName',
          'tagline',
          'supportEmail',
          'supportPhone',
          'announcementEnabled',
          'updatedAt',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'brandName',
          'tagline',
          'supportEmail',
          'supportPhone',
          'announcementEnabled',
          'updatedAt',
          'updatedBy'
        ])
        && data.brandName is string
        && data.brandName.size() >= 1
        && data.brandName.size() <= 80
        && !data.brandName.matches('^\\s*$')
        && data.tagline is string
        && data.tagline.size() >= 1
        && data.tagline.size() <= 200
        && !data.tagline.matches('^\\s*$')
        && data.supportEmail is string
        && data.supportEmail.size() >= 3
        && data.supportEmail.size() <= 254
        && !data.supportEmail.matches('^\\s*$')
        && data.supportPhone is string
        && data.supportPhone.size() >= 3
        && data.supportPhone.size() <= 40
        && !data.supportPhone.matches('^\\s*$')
        && data.announcementEnabled is bool
        && data.updatedAt is timestamp
        && data.updatedBy is string && isValidId(data.updatedBy);
    }

    function isValidSupportMessage(data) {
      return data.keys().hasAll([
          'userId',
          'senderName',
          'senderEmail',
          'subject',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'senderName',
          'senderEmail',
          'subject',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string && isValidId(data.userId)
        && data.senderName is string
        && data.senderName.size() >= 1
        && data.senderName.size() <= 100
        && !data.senderName.matches('^\\s*$')
        && data.senderEmail is string && data.senderEmail.size() >= 3 && data.senderEmail.size() <= 254
        && data.subject is string
        && data.subject.size() >= 2
        && data.subject.size() <= 160
        && !data.subject.matches('^\\s*$')
        && data.message is string
        && data.message.size() >= 5
        && data.message.size() <= 2000
        && !data.message.matches('^\\s*$')
        && data.status in ['open', 'in_progress', 'resolved']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // /users/{userId} — Private Customer Profiles (Strict PII Isolation)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.auth.token.email is string
        && isValidId(userId)
        && isOwner(userId)
        && isValidCustomerProfile(incoming(), userId)
        && incoming().email == request.auth.token.email
        && incoming().emailVerified == request.auth.token.email_verified
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidCustomerProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().emailVerified == request.auth.token.email_verified
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'phone',
              'preferredCountry',
              'emailVerified',
              'updatedAt'
            ])
          )
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // -------------------------------------------------------------------------
    // /userPreferences/{userId} — Authenticated User Preferences
    // -------------------------------------------------------------------------
    match /userPreferences/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPreferences(incoming(), userId)
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserPreferences(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'preferredCountry',
              'emailNotifications',
              'whatsappUpdates',
              'cookieConsent',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) && ((isVerifiedUser() && isOwner(userId)) || isAdmin());
    }

    // -------------------------------------------------------------------------
    // /settings/{settingId} — Public Non-Transactional Website Settings
    // -------------------------------------------------------------------------
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'public' || isAdmin());
      allow list: if false;

      allow create: if isAdmin()
        && isValidId(settingId)
        && isValidWebsiteSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.uid;

      allow update: if isAdmin()
        && isValidId(settingId)
        && isValidWebsiteSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'brandName',
          'tagline',
          'supportEmail',
          'supportPhone',
          'announcementEnabled',
          'updatedAt',
          'updatedBy'
        ]);

      allow delete: if isAdmin() && isValidId(settingId);
    }

    // -------------------------------------------------------------------------
    // /supportMessages/{messageId} — Secure Customer Support Inquiries
    // -------------------------------------------------------------------------
    match /supportMessages/{messageId} {
      allow get: if isSignedIn()
        && isValidId(messageId)
        && (isAdmin() || (resource != null && existing().userId == request.auth.uid));

      allow list: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser()
        && isValidId(messageId)
        && isValidSupportMessage(incoming())
        && incoming().userId == request.auth.uid
        && incoming().senderEmail == request.auth.token.email
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(messageId)
        && isValidSupportMessage(incoming())
        && existing().status != 'resolved'
        && (
          (existing().status == 'open' && incoming().status in ['in_progress', 'resolved']) ||
          (existing().status == 'in_progress' && incoming().status == 'resolved')
        )
        && incoming().userId == existing().userId
        && incoming().senderEmail == existing().senderEmail
        && incoming().senderName == existing().senderName
        && incoming().subject == existing().subject
        && incoming().message == existing().message
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(messageId);
    }
  }
}
